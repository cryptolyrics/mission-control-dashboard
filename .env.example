# Mission Control Dashboard Environment (example)
MC_API_BASE_URL=https://mc-api.elevatestudios.io
MC_API_KEY=replace-with-key
RELAY_BASE_URL=https://mc-api.elevatestudios.io
RELAY_AUTH_TOKEN=
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
MC_API_PORT=3008

# Dashboard auth (required)
PRIVATE_DASH_USER=admin
# Use one of these:
# PRIVATE_DASH_PASSWORD_HASH=<bcrypt hash>
PRIVATE_DASH_PASSWORD=replace-with-password
PRIVATE_DASH_SESSION_TOKEN=replace-with-session-token
